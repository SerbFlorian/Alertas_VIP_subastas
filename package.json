{
  "name": "alertas-vip-subastas",
  "version": "1.0.0",
  "description": "Bot de alertas de subastas de vehículos embargados del BOE para Telegram",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc && node -e \"require('fs').mkdirSync('dist/data',{recursive:true});require('fs').copyFileSync('src/data/car-specifications.json','dist/data/car-specifications.json')\"",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "scraper": "ts-node --transpile-only src/jobs/scraper.job.ts",
    "notifier": "ts-node --transpile-only src/jobs/notifier.job.ts",
    "matching": "ts-node --transpile-only src/jobs/notifier.job.ts",
    "flush-queue": "ts-node --transpile-only src/jobs/queue-flush.job.ts",
    "publico": "ts-node --transpile-only -e \"require('dotenv').config(); const {ensureRedisReady,disconnectRedis}=require('./src/db/redis'); const {ejecutarCanalPublicoJob}=require('./src/jobs/notifier.job'); ensureRedisReady().then(()=>ejecutarCanalPublicoJob()).then(()=>disconnectRedis()).then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\"",
    "cleanup": "ts-node --transpile-only src/jobs/cleanup.job.ts",
    "backup": "ts-node --transpile-only src/jobs/backup.job.ts",
    "restore:latest": "ts-node --transpile-only src/jobs/restore.job.ts",
    "reset-counts": "ts-node --transpile-only src/admin/reset_counts.ts",
    "check-matches": "ts-node --transpile-only src/admin/check_matches.ts",
    "db:reset": "prisma db push --force-reset",
    "stats": "ts-node --transpile-only src/jobs/inventory-stats.job.ts",
    "title-cleanup": "ts-node --transpile-only src/jobs/title-cleanup.job.ts",
    "backfill-norms": "ts-node --transpile-only src/admin/backfill_norms.ts",
    "verify:system": "node dist/scripts/verify-system.js",
    "verify:system:dev": "ts-node src/scripts/verify-system.ts",
    "ops:reminder": "node dist/jobs/ops-reminder.job.js",
    "ops:reminder:dev": "ts-node src/jobs/ops-reminder.job.ts",
    "migrate:boot": "node dist/scripts/migrate-boot.js",
    "db:migrate": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm audit --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@prisma/client": "^6.19.3",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.6.1",
    "node-cron": "^3.0.3",
    "openai": "^4.104.0",
    "playwright-core": "^1.61.1",
    "stripe": "^17.5.0",
    "telegraf": "^4.16.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
