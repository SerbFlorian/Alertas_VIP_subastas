# ============================================================
# Alertas VIP Subastas — plantilla (.env)
# cp .env.example .env && chmod 600 .env
# Solo variables usadas por código o docker-compose.yml
# ============================================================

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SubastasVIP_bot
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_CHANNEL_PUBLICO_ID=

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_PORTAL_URL=
STRIPE_TIER1_MAX=200
STRIPE_TIER2_MAX=1000
STRIPE_PAYMENT_LINK_TIER1=
STRIPE_PAYMENT_LINK_TIER2=
STRIPE_PAYMENT_LINK_TIER3=
STRIPE_WEBHOOK_RATE_LIMIT_MAX=60
STRIPE_WEBHOOK_RATE_LIMIT_WINDOW_MS=60000

# ── Postgres + Redis ──────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=subastas_vip
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/subastas_vip?schema=public
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@redis:6379

# ── App ───────────────────────────────────────────────────────
PORT=3002
LOG_LEVEL=info

# ── Digests VIP ───────────────────────────────────────────────
# Cadencia por defecto (nuevos VIP / fallback). Cada VIP puede cambiarla con /horario.
NOTIFIER_INTERVAL_MINUTES=120
NOTIFIER_TICK_MINUTES=5
NOTIF_MAX_MESSAGES_PER_USER=1
NOTIF_MAX_PENDING_PER_USER=3
NOTIF_SEND_DELAY_MS=1000
# Hard floor del sistema (Europe/Madrid). /horario no puede salir de aquí.
NOTIF_HARD_START_HOUR=7
NOTIF_HARD_END_HOUR=23
# Defaults al crear VIP (start inclusiva, end exclusiva)
NOTIF_WINDOW_START_HOUR=8
NOTIF_WINDOW_END_HOUR=21
DIGEST_WARMUP_MIN_MINUTES=5
DIGEST_WARMUP_MAX_MINUTES=15
DIGEST_WARMUP_QUOTA_HOURS=24

# ── Matching + canal público ──────────────────────────────────
MATCHING_INTERVAL_MINUTES=30
# Lookback matching (min). Default en código = 1440 (24 h) si no se define.
NOTIFIER_LOOKBACK_MINUTES=1440
MAX_PUBLICACIONES_PUBLICAS_DIARIAS=1

# ── Cleanup ───────────────────────────────────────────────────
DATA_PURGE_HOURS=48
CLEANUP_HORAS_TELEGRAM=48

# ── Scrapers ──────────────────────────────────────────────────
REQUEST_DELAY_MS=2000
MAX_RETRIES=3
SCRAPER_STEADY_ONLY=true
SCRAPER_WINDOW_SIZE=5
SCRAPER_STEADY_PAGES=5
SCRAPER_CRON="0 8,14,20 * * 1-5"

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=
AI_VIP_DAILY_MAX=20
AI_VIP_WEEKLY_MAX=140
AI_INVENTORY_DAILY_MAX=3
AI_INVENTORY_DAILY_MAX_FREE=1
AI_BROKEN_LINK_DAILY_MAX=1
AI_TIMEOUT_MS=120000

# ── R2 backups ────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
BACKUP_RETENTION_DAYS=7
BACKUP_CRON="0 6 * * *"

# ── Ops ───────────────────────────────────────────────────────
OPS_REMINDER_CRON="0 9 1 * *"
